APP_NAME=Safety Detect
APP_ENV=development
# 仅本地开发使用 SQLite；生产必须由进程管理器注入 MySQL 8.0.13+ URL
DATABASE_URL=sqlite:///data/safety_detect.db
# 本地开发留空时使用一次性默认密码 admin123456；首次登录后必须修改
# 生产环境必须由进程管理器安全注入，不能使用开发默认值
ADMIN_INITIAL_PASSWORD=
SESSION_TTL_HOURS=12
COOKIE_SECURE=false
UPLOAD_DIR=data/uploads
SNAPSHOT_DIR=data/snapshots
# 多图识别必须指向存在且与 Ultralytics 兼容的模型；留空时批量上传返回 model_unavailable
MODEL_PATH=
# 可选：中文标注字体文件；Windows 通常会自动找到微软雅黑
ANNOTATION_FONT_PATH=
BATCH_RETENTION_DAYS=30
# 当前版本固定为单个批量工作线程，其他值会拒绝启动
BATCH_WORKER_COUNT=1
WORKER_COUNT=1
FRAME_QUEUE_SIZE=8
RECONCILE_INTERVAL=3
ENABLE_RUNTIME=true
FEISHU_WEBHOOK=

# 本地模型训练；远程训练和 Atlas OM 转换暂未开放
TRAINING_ENABLED=true
TRAINING_DATASET_YAML=training/configs/construction-ppe-helmet.yaml
# 分号分隔的“别名=绝对目录”；网页只能浏览这些目录，目录必须在启动前存在
TRAINING_DATASET_ROOTS=default=D:\free\datasets
TRAINING_RUN_DIR=data/training-runs
TRAINING_MODEL_CACHE_DIR=data/training-models
TRAINING_LOG_TAIL_BYTES=65536
TRAINING_STOP_TIMEOUT_SECONDS=15
