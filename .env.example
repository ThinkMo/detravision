APP_NAME=Safety Detect
APP_ENV=development
DATABASE_URL=sqlite:///data/safety_detect.db
# 本地开发留空时使用一次性默认密码；生产环境必须由进程管理器安全注入
ADMIN_INITIAL_PASSWORD=
SESSION_TTL_HOURS=12
COOKIE_SECURE=false
UPLOAD_DIR=data/uploads
SNAPSHOT_DIR=data/snapshots
MODEL_PATH=
WORKER_COUNT=1
FRAME_QUEUE_SIZE=8
RECONCILE_INTERVAL=3
ENABLE_RUNTIME=true
FEISHU_WEBHOOK=
